@model PortalCalendarServer.Models.POCOs.ConfigSelectModel
@using PortalCalendarServer.Services
@inject IDisplayService DisplayService
@inject IViewLocalizer Localizer

@{
    var currentValue = DisplayService.GetConfigWithoutDefaults(Model.Display, Model.Key);
    var inheritedValue = DisplayService.GetParentConfig(Model.Display, Model.Key);
    var inheritedLabel = "";
    if (!string.IsNullOrEmpty(inheritedValue))
    {
        var matchingOption = Model.Options.FirstOrDefault(o => o.Value == inheritedValue);
        inheritedLabel = matchingOption != null ? matchingOption.Text : inheritedValue;
    }
    var wrapClass = string.Join(" ", new[] { Model.ColClass, Model.MarginClass }.Where(s => !string.IsNullOrEmpty(s)));
}

<div class="@wrapClass">
    @if (!string.IsNullOrEmpty(Model.Label))
    {
        <label for="@Model.Key">@Model.Label</label>
    }
    <select id="@Model.Key" name="@Model.Key"
            class="form-select"
            @(Model.Disabled ? Html.Raw("disabled") : Html.Raw(""))>
        @if (Model.AllowEmpty)
        {
            @if (!string.IsNullOrEmpty(inheritedLabel))
            {
                <option value="">@Localizer["(inherited: {0})", inheritedLabel]</option>
            }
            else
            {
                <option value=""></option>
            }
        }
        @foreach (var option in Model.Options)
        {
            <option value="@option.Value" selected="@(currentValue == option.Value)">@option.Text</option>
        }
    </select>
    @if (!string.IsNullOrEmpty(Model.HelpText))
    {
        @if (Model.HelpTextIsHtml)
        {
            <div class="form-text">@Html.Raw(Model.HelpText)</div>
        }
        else
        {
            <div class="form-text">@Model.HelpText</div>
        }
    }
</div>
