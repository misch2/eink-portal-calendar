@model PortalCalendarServer.Services.PageViewModel

@{
    Layout = "~/Views/Shared/Layouts/Epaper/_FullBleedLayout.cshtml";
    ViewBag.Title = "Image gallery";

    var gallery = Model.Gallery;
    var imageInfo = gallery?.GetRandomImage(Model.Display);
    var hasDescription = imageInfo != null && !imageInfo.HideDescriptions && !string.IsNullOrEmpty(imageInfo.Description);
}

@section Head {
    <link rel="stylesheet" href="/css/calendar_themes/gallery.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jersey+25&display=swap" rel="stylesheet">
}

@{
    var rotClass = imageInfo?.Rotation switch { 90 => "rot-90", 180 => "rot-180", 270 => "rot-270", _ => "" };
    var sizingClass = imageInfo?.ImageSizing switch { "cover" => "sizing-cover", "fill" => "sizing-fill", _ => "" };
}

@if (imageInfo != null)
{
    <div id="gallery-container" class="@(hasDescription ? "with-description" : "") @rotClass @sizingClass" style="--gallery-bg: url('@imageInfo.ImageUrl')">
        <img id="gallery-image" src="@imageInfo.ImageUrl" alt="@(imageInfo.Description ?? "Gallery image")" />
        @if (hasDescription)
        {
            <div id="gallery-description">@imageInfo.Description</div>
        }
    </div>
}
else
{
    <div id="gallery-no-image">
        No image available. Please configure a gallery with images.
    </div>
}
