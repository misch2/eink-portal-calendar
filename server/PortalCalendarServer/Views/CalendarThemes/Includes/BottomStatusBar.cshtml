@using PortalCalendarServer.Models.DatabaseEntities
@using PortalCalendarServer.Services
@inject IDisplayService displayService
@model Display

@* iconify-icon library — required by _BatteryStatusIcon, _LastRenderInfo, and _WakeupInfo partials.
   Loaded here (rather than in each theme) so themes including this bar can't accidentally omit it. *@
<script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js"></script>

<style type="text/css">
    div#bottom-bar {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-top: auto;
        width: 100%;
    }

    div#bottom-wakeupinfo, div#bottom-lastrenderinfo {
        margin-top: 0;
        font-size: 0.7rem;
        /* position: relative; */
        /* top: 0.6rem; */
    }

    div#battery-status {
        margin-left: auto;
        text-align: right;
        font-size: 1.3rem;
        position: relative;
        top: 0.6rem;
    }
</style>


<div id="bottom-bar">
    @if (displayService.GetConfigBool(Model, "theme_config_status_lastrenderinfo"))
    {
        <div id="bottom-lastrenderinfo">
            @await Html.PartialAsync("~/Views/CalendarThemes/Includes/_LastRenderInfo.cshtml", Model)
        </div>
    }

    @if (displayService.GetConfigBool(Model, "theme_config_status_wakeupinfo"))
    {
        <div id="bottom-wakeupinfo">
            @await Html.PartialAsync("~/Views/CalendarThemes/Includes/_WakeupInfo.cshtml", Model)
        </div>
    }

    @if (displayService.GetConfigBool(Model, "theme_config_status_battery"))
    {
        <div id="battery-status">
            @await Html.PartialAsync("~/Views/CalendarThemes/Includes/_BatteryStatusIcon.cshtml", Model)
        </div>
    }
</div>