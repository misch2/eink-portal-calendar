@using PortalCalendarServer.Models.DatabaseEntities
@model Display

<style type="text/css">
    div#bottom-bar {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-top: auto;
        width: 100%;
    }

    div#bottom-wakeupinfo {
        margin-top: 0;
        font-size: 0.7rem;
        /* position: relative; */
        /* top: 0.6rem; */
    }

    div#battery-status {
        text-align: right;
        font-size: 1.3rem;
        position: relative;
        top: 0.6rem;
    }
</style>


<div id="bottom-bar">
    <div id="bottom-wakeupinfo">
        @await Html.PartialAsync("~/Views/CalendarThemes/Includes/_WakeupInfo.cshtml", Model)
    </div>
    <div id="battery-status">
        @await Html.PartialAsync("~/Views/CalendarThemes/Includes/_BatteryStatusIcon.cshtml", Model)
    </div>
</div>