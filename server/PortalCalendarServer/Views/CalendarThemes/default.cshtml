@model PortalCalendarServer.Services.PageViewModel
@{
    Layout = "~/Views/Shared/Layouts/Epaper/_FullBleedLayout.cshtml";
    ViewBag.Title = "Calendar - Default";
}

@section Head {
    <style>
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: var(--epd-white);
        }
        
        .content-container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        
        h1 {
            font-size: clamp(60px, 15vw, 120px);
            font-weight: bold;
            margin: 0;
            padding: 20px;
            color: var(--epd-black);
        }
        
        p {
            font-size: clamp(30px, 7.5vw, 60px);
            margin: 20px 0 0 0;
            color: var(--epd-black);
        }
    </style>
}

<h1>It works!</h1>
<p>This is display @Model.Display.Mac</p>
