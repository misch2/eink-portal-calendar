@model Display
@using PortalCalendarServer.Models.DatabaseEntities
@using PortalCalendarServer.Models.POCOs
@using PortalCalendarServer.Services
@using PortalCalendarServer.Modules.Builtin;
@inject IDisplayService displayService
@inject IGalleryService galleryService
@inject IViewLocalizer Localizer

@{
    var galleries = await galleryService.GetVisibleGalleriesAsync();
}


<div class="row mb-2">
    <div class="col-md-4"><strong>@Localizer["Gallery"]</strong></div>
    <div class="col-md-1"><strong>@Localizer["Hide descriptions"]</strong></div>
    <div class="col-md-2"><strong>@Localizer["Image sizing"]</strong></div>
    <div class="col-md-2"><strong>@Localizer["Preference ratio"]</strong></div>
</div>

@for (int i = 1; i <= GalleryModule.MaxGalleries; i++)
{
    var currentValue = displayService.GetConfigWithoutDefaults(Model, $"gallery_id_{i}");

    <div class="row mb-2 align-items-center">
        <div class="col-md-4">
            <select id="@($"gallery_id_{i}")" name="@($"gallery_id_{i}")" class="form-select">
                <option value=""></option>
                @foreach (var gallery in galleries)
                {
                    <option value="@gallery.Id" selected="@(currentValue == gallery.Id.ToString())">
                        @(i). @gallery.Name (@gallery.Images.Count @Localizer["images"])
                    </option>
                }
            </select>
        </div>
        @await Html.PartialAsync("_ConfigCheckbox", new ConfigInputModel
        {
            Display = Model, Key = $"gallery_hide_descriptions_{i}",
            Label = "",
            ColClass = "col-md-1"
        })
        @await Html.PartialAsync("_ConfigSelect", new ConfigSelectModel
        {
            Display = Model, Key = $"gallery_image_sizing_{i}",
            Label = "",
            ColClass = "col-md-2",
            Options = new List<SelectOption>
            {
                new() { Value = "", Text = Localizer["Fit (contain)"].Value },
                new() { Value = "cover", Text = Localizer["Crop (cover)"].Value },
                new() { Value = "fill", Text = Localizer["Stretch (fill)"].Value },
            }
        })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = $"gallery_preference_ratio_{i}",
            Label = "",
            InputType = "number",
            ColClass = "col-md-2"
        })
    </div>
}