@model Display
@using PortalCalendarServer.Models.DatabaseEntities
@using PortalCalendarServer.Models.POCOs
@inject IViewLocalizer Localizer

@await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
{
    Display = Model, Key = "webimage_url", Label = Localizer["Image URL"].Value,
        ColClass = "col-md-12", MarginClass = "mt-2"
})

@await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
{
    Display = Model, Key = "webimage_cache_hours", Label = Localizer["Cache for N hours"].Value,
        ColClass = "col-md-3"
})
