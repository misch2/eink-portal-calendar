@model Display
@using PortalCalendarServer.Models.DatabaseEntities
@using PortalCalendarServer.Models.POCOs
@using PortalCalendarServer.Modules.Builtin
@using PortalCalendarServer.Services
@using PortalCalendarServer.Services.PageGeneratorComponents
@using Microsoft.Extensions.Caching.Memory
@inject IDisplayService displayService
@inject IHttpClientFactory httpClientFactory
@inject IMemoryCache memoryCache
@inject ILoggerFactory loggerFactory
@inject IViewLocalizer Localizer

@{
    // Fetch moisture entities from Home Assistant
    var moistureEntities = new List<HomeAssistantEntity>();
    var haConfigured = displayService.GetConfigBool(Model, "homeassistant");
    if (haConfigured)
    {
        try
        {
            var haComponent = new HomeAssistantComponent(displayService, httpClientFactory, memoryCache, loggerFactory);
            var allEntities = await haComponent.GetStatesAsync(Model);
            moistureEntities = allEntities
                .Where(e => e.GetAttribute("device_class") == "moisture")
                .OrderBy(e => e.FriendlyName)
                .ToList();
        }
        catch
        {
            // HA unreachable — dropdowns will be empty
        }
    }
}

@await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
{
    Display = Model, Key = "display_title", Label = Localizer["Title"].Value,
    ColClass = "col-12", MarginClass = "mb-3"
})

<div class="row">
    @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
    {
        Display = Model, Key = "plantwatering_threshold_dry", Label = Localizer["Global dry threshold (%)"].Value,
        ColClass = "col-md-3", InputType = "number", Step = "1",
        HelpText = Localizer["Below this moisture % the plant is considered too dry (default: 20)"].Value
    })
    @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
    {
        Display = Model, Key = "plantwatering_threshold_wet", Label = Localizer["Global wet threshold (%)"].Value,
        ColClass = "col-md-3", InputType = "number", Step = "1",
        HelpText = Localizer["Above this moisture % the plant is considered too wet (default: 80)"].Value
    })
</div>

<div class="row mt-3">
    <div class="col-12">
        <label class="form-label fw-bold">@Localizer["Moisture sensors"]</label>
        @if (!haConfigured)
        {
            <div class="form-text text-warning mb-2">@Localizer["Enable and configure Home Assistant integration first to populate sensor list."]</div>
        }
        else if (moistureEntities.Count == 0)
        {
            <div class="form-text text-warning mb-2">@Localizer["No moisture sensors found in Home Assistant. Check your connection settings."]</div>
        }
        else
        {
            <div class="form-text mb-2">@Localizer["Select moisture sensors to monitor ({0} available).", moistureEntities.Count]</div>
        }
    </div>
</div>

@for (int i = 1; i <= PlantWateringModule.MaxSensors; i++)
{
    var key = $"plantwatering_sensor_{i}";
    var currentValue = displayService.GetConfigWithoutDefaults(Model, key);

    <div class="row mb-2">
        <div class="col-md-5">
            <label for="@key">@Localizer["Sensor {0}", i]</label>
            <select id="@key" name="@key" class="form-select">
                <option value=""></option>
                @foreach (var entity in moistureEntities)
                {
                    var label = $"{entity.FriendlyName} ({entity.EntityId})";
                    if (entity.State != "unavailable" && entity.State != "unknown")
                    {
                        label += $" — {entity.State}{entity.UnitOfMeasurement}";
                    }
                    <option value="@entity.EntityId" selected="@(currentValue == entity.EntityId)">@label</option>
                }
                @if (!string.IsNullOrEmpty(currentValue) && !moistureEntities.Any(e => e.EntityId == currentValue))
                {
                    @* Preserve previously saved value even if entity is no longer available *@
                    <option value="@currentValue" selected="selected">@currentValue (@Localizer["not found"])</option>
                }
            </select>
        </div>
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = $"plantwatering_sensor_{i}_threshold_dry", Label = Localizer["Dry threshold (%)"].Value,
            ColClass = "col-md-2", InputType = "number", Step = "1"
        })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = $"plantwatering_sensor_{i}_threshold_wet", Label = Localizer["Wet threshold (%)"].Value,
            ColClass = "col-md-2", InputType = "number", Step = "1"
        })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = $"plantwatering_sensor_{i}_name_override", Label = Localizer["Name override"].Value,
            ColClass = "col-md-2", InputType = "text"
        })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = $"plantwatering_sensor_{i}_order_in_area", Label = Localizer["Order (in area)"].Value,
            ColClass = "col-md-1", InputType = "number", Step = "1"
        })

    </div>
}

@await Html.PartialAsync("~/Views/CalendarThemes/Configs/_BottomStatusBar.cshtml")
