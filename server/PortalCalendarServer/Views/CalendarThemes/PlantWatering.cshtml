@model PortalCalendarServer.Services.PageViewModel
@using PortalCalendarServer.Modules.Builtin
@using PortalCalendarServer.Services
@using PortalCalendarServer.Services.PageGeneratorComponents
@inject IDisplayService displayService
@inject IViewLocalizer Localizer
@{
    Layout = "~/Views/Shared/Layouts/Epaper/_InsetLayout.cshtml";
    ViewBag.Title = "Plant Watering";

    var ha = Model.GetComponent<HomeAssistantComponent>("homeassistant");
    var title = displayService.GetConfig(Model.Display, "display_title");
    if (string.IsNullOrWhiteSpace(title)) title = "Plant Watering Monitor";

    // Read configured sensor entity IDs and per-sensor thresholds
    var sensorIds = new List<string>();
    var sensorDryThresholds = new Dictionary<string, int>();
    var sensorWetThresholds = new Dictionary<string, int>();
    for (int i = 1; i <= PlantWateringModule.MaxSensors; i++)
    {
        var sensorId = displayService.GetConfig(Model.Display, $"plantwatering_sensor_{i}");
        if (!string.IsNullOrWhiteSpace(sensorId))
        {
            var id = sensorId.Trim();
            sensorIds.Add(id);
            var perDry = displayService.GetConfigInt(Model.Display, $"plantwatering_sensor_{i}_threshold_dry");
            if (perDry.HasValue) sensorDryThresholds[id] = perDry.Value;
            var perWet = displayService.GetConfigInt(Model.Display, $"plantwatering_sensor_{i}_threshold_wet");
            if (perWet.HasValue) sensorWetThresholds[id] = perWet.Value;
        }
    }

    // Read global thresholds (used as fallback)
    var dryThreshold = displayService.GetConfigInt(Model.Display, "plantwatering_threshold_dry") ?? 20;
    var wetThreshold = displayService.GetConfigInt(Model.Display, "plantwatering_threshold_wet") ?? 80;

    // History chart settings
    var historyDays = displayService.GetConfigInt(Model.Display, "plantwatering_history_days") ?? 7;

    // Fetch entity details with device/area info
    var details = ha != null && sensorIds.Count > 0
        ? await ha.GetEntityDetailsAsync(Model.Display, sensorIds)
        : [];

    // Fetch history for sparklines
    var historyFrom = DateTime.UtcNow.AddDays(-historyDays);
    var historyTo = DateTime.UtcNow;
    var history = ha != null && sensorIds.Count > 0
        ? await ha.GetEntityHistoryAsync(Model.Display, sensorIds, historyFrom, historyTo)
        : new Dictionary<string, IReadOnlyList<HistoryPoint>>();

    // Build plant info and group by area
    var plants = details.Select(d =>
    {
        double? moisture = null;
        string status = "unavailable";

        // Use per-sensor thresholds if configured, otherwise fall back to global
        var dry = sensorDryThresholds.GetValueOrDefault(d.EntityId, dryThreshold);
        var wet = sensorWetThresholds.GetValueOrDefault(d.EntityId, wetThreshold);

        var entityHistory = history.GetValueOrDefault(d.EntityId) ?? (IReadOnlyList<HistoryPoint>)[];

        if (d.Entity != null && double.TryParse(d.Entity.State, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var val))
        {
            moisture = val;
        }

        if (moisture == null)
        {
            // try to get last known value from history (max 1 hour old) if current state is unavailable
            var lastKnown = entityHistory.LastOrDefault(p => p.Time >= DateTime.UtcNow.AddHours(-1));
            if (lastKnown != null)
            {
                moisture = lastKnown.Value;
                status = "stale";   // won't get used in this case, but could be used to e.g. show a warning icon in the future if desired
            }
        }

        if (moisture != null)
        {
            if (moisture < dry) status = "dry";
            else if (moisture > wet) status = "wet";
            else status = "ok";
        }

        var modifiedDeviceName = d.DeviceName;
        if (!string.IsNullOrEmpty(modifiedDeviceName))
        {
            // Remove everything after "/" (including it) from friendly name to avoid cluttering the dropdown with device names (e.g. "Plant Sensor / Moisture" becomes just "Plant Sensor")
            modifiedDeviceName = System.Text.RegularExpressions.Regex.Replace(modifiedDeviceName, @" */.*$", "");
        }

        return new
        {
            EntityId = d.EntityId,
            Name = modifiedDeviceName ?? d.Entity?.FriendlyName ?? d.EntityId,
            Area = d.AreaName ?? Localizer["Unassigned"].Value,
            Moisture = moisture,
            Status = status,
            DryThreshold = dry,
            WetThreshold = wet,
            History = entityHistory
        };
    }).ToList();

    var groupedByArea = plants
        .GroupBy(p => p.Area)
        .OrderBy(g => g.Key)
        .ToList();
}

@section Head {
    <link rel="stylesheet" href="/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/calendar_themes/plantwatering.css" asp-append-version="true" />
}

@if (sensorIds.Count == 0)
{
    <div class="no-sensors">@Localizer["No moisture sensors configured."]</div>
}
else
{
    <div class="header">@title</div>

    @foreach (var area in groupedByArea)
    {
        <div class="area-section">
            <div class="area-name">@area.Key</div>

            @foreach (var plant in area.OrderBy(p => p.Name))
            {
                var barWidth = plant.Moisture.HasValue
                ? Math.Clamp(plant.Moisture.Value, 0, 100)
                : 0;

                <div class="plant-row status-@plant.Status">
                    <div class="plant-name">@plant.Name</div>
                    <div class="plant-moisture">
                        @if (plant.Moisture.HasValue)
                        {
                            @($"{plant.Moisture.Value:F0} %")
                        }
                        else
                        {
                            <text>@Localizer["N/A"]</text>
                        }
                    </div>
                    <div class="moisture-bar-container">
                        <div class="moisture-bar-fill" style="width: @($"{barWidth:F0}")%"></div>
                        <div class="moisture-bar-marker" style="left: @plant.DryThreshold%"></div>
                        <div class="moisture-bar-marker" style="left: @plant.WetThreshold%"></div>
                    </div>
                    @{
                        const int svgW = 80;
                        const int svgH = 24;
                        const int pad = 1;

                        @if (plant.History.Count >= 2)
                        {

                            var minT = plant.History[0].Time.Ticks;
                            var maxT = plant.History[^1].Time.Ticks;
                            var rangeT = maxT - minT;
                            if (rangeT == 0) rangeT = 1;

                            var minV = 0; //  Math.Min(plant.History.Min(p => p.Value), 0);
                            var maxV = 100; // Math.Max(plant.History.Max(p => p.Value), 100);

                            var rangeV = maxV - minV;
                            if (rangeV == 0) rangeV = 1;

                            var points = string.Join(" ", plant.History.Select(p =>
                            {
                                var x = pad + (double)(p.Time.Ticks - minT) / rangeT * (svgW - 2 * pad);
                                var y = pad + (1.0 - (p.Value - minV) / rangeV) * (svgH - 2 * pad);
                                return $"{x:F1},{y:F1}";
                            }));

                            // Threshold lines as Y positions
                            var dryY = pad + (1.0 - (plant.DryThreshold - minV) / rangeV) * (svgH - 2 * pad);
                            var wetY = pad + (1.0 - (plant.WetThreshold - minV) / rangeV) * (svgH - 2 * pad);

                            <svg class="sparkline" viewBox="0 0 @svgW @svgH" preserveAspectRatio="none">
                                <line x1="0" y1="@($"{dryY:F1}")" x2="@svgW" y2="@($"{dryY:F1}")" class="sparkline-threshold" />
                                <line x1="0" y1="@($"{wetY:F1}")" x2="@svgW" y2="@($"{wetY:F1}")" class="sparkline-threshold" />
                                <polyline points="@points" class="sparkline-line" />
                            </svg>
                        }
                        else
                        {
                            <svg class="sparkline" viewBox="0 0 @svgW @svgH" preserveAspectRatio="none">
                            </svg>
                        }
                    }
                </div>
            }
        </div>
    }
}

@await Html.PartialAsync("~/Views/CalendarThemes/Includes/BottomStatusBar.cshtml", Model.Display)
