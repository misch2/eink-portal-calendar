@using PortalCalendarServer.Models.POCOs
@model PortalCalendarServer.Services.PageViewModel
@{
    Layout = "~/Views/Shared/Layouts/Epaper/_FullBleedLayout.cshtml";
    ViewBag.Title = "Page Rendering Error";

    var error = Model.Error;
}

@section Head {
    @* Stylesheets *@
    <link rel="stylesheet" href="/css/calendar_themes/error.css" asp-append-version="true" />
}

<div class="error-content">
    <div class="error-icon">⚠️</div>
    <div class="error-title">Error</div>
    <div class="error-subtitle">Page rendering failed</div>
    <div class="error-message">
        @error?.Message
        @if (error != null && error.ShowDetails && !string.IsNullOrEmpty(error.Details))
        {
            <pre>@error.Details</pre>
        }
    </div>
    <div class="error-timestamp">@(error?.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") ?? "") UTC</div>
</div>
