@model Display
@using PortalCalendarServer.Controllers
@using PortalCalendarServer.Models.DatabaseEntities
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Test - {0}", Model.Name].Value;
}

<!-- https://css-tricks.com/snippets/css/a-guide-to-flexbox/ -->
<div style="display: flex; flex-flow: row wrap; justify-content: space-around;">
    <div>
        @{
            var pageUrl = Url.Action(nameof(UiController.CalendarHtmlDefaultDate), "Ui", new { displayNumber = Model.Id, preview_colors = true });
        }
        @Localizer["Calendar page <a href='{0}'>as HTML</a>:", pageUrl]
        <br>
        <iframe src="@pageUrl"
                width="@Model.VirtualWidth()"
                height="@Model.VirtualHeight()"
                style="border: 1px solid black">
        </iframe>
    </div>
    <div>
        @{
            var bitmapUrl = Url.Action(nameof(UiController.Bitmap), "Ui", new { displayNumber = Model.Id });
            var rendered_ago = Model.RenderedAt.HasValue
                ? Localizer["rendered {0} minutes ago", $"{(DateTime.UtcNow - Model.RenderedAt.Value).TotalMinutes:F0}"].Value
                : Localizer["never rendered"].Value;
        }
        @Localizer["Calendar page <a href='{0}'>as IMG</a> with fixed size ({1}):", bitmapUrl, rendered_ago]
        <br>
        <img src="@bitmapUrl"
             style="border: 1px solid black"
             alt="Calendar as image">
    </div>
</div>
