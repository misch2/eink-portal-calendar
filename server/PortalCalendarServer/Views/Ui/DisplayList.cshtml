@model List<Display>
@using PortalCalendarServer.Controllers
@using PortalCalendarServer.Models.DatabaseEntities
@using PortalCalendarServer.Services
@inject IDisplayService displayService
@inject ICurrentUserProvider CurrentUser
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Displays"].Value;
}

<div class="mb-3">
    @Html.AntiForgeryToken()
    <button id="pairing-btn" class="btn btn-secondary btn-sm" onclick="togglePairing()">
        @Localizer["Enable Pairing Mode (5 min)"]
    </button>
</div>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">@Localizer["Name"]</th>
            <th scope="col">@Localizer["Resolution"]</th>
            <th scope="col">@Localizer["Display type"]</th>
            <th scope="col">@Localizer["Firmware"]</th>
            <th scope="col">@Localizer["Battery"]</th>
            <th scope="col">
                @Localizer["Next wakeup"]
                <br />
                @Localizer["(local time)"]
            </th>
            <th scope="col">@Localizer["Status"]</th>
            <th scope="col">@Localizer["Owner"]</th>
            <th scope="col">@Localizer["Last image"]</th>
            <th scope="col">@Localizer["Bitmap age"]</th>
            <th scope="col">@Localizer["Action"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var _d in Model)
        {
            var d = displayService.GetVisibleDisplayById(_d.Id);
            if (d == null) continue;

            var dateCulture = displayService.GetDateCultureInfo(d);
            var tz = displayService.GetTimeZoneInfo(d);

            <tr>
                <td>
                    @if (d.IsDefault())
                    {
                        <a href="@Url.Action(nameof(UiController.ConfigUiShow), "Ui", new { displayNumber = d.Id })">@d.Name</a>
                    }
                    else
                    {
                        <a href="@Url.Action(nameof(UiController.Home), "Ui", new { displayNumber = d.Id })">@d.Name</a>
                    }
                </td>
                <td>
                    @if (!d.IsDefault())
                    {
                        @($"{d.VirtualWidth()} × {d.VirtualHeight()}")
                    }
                </td>
                <td>
                    @d.ColorVariant.Code
                </td>
                <td>@d.Firmware</td>
                <td class="text-end">
                    @if (!d.IsDefault())
                    {
                        var batteryPercent = displayService.GetBatteryPercent(d);
                        if (batteryPercent.HasValue)
                        {
                            @($"{batteryPercent.Value:F0} %")
                        }
                    }
                </td>
                <td class="text-nowrap">
                    @if (!d.IsDefault())
                    {
                        var nextWakeupInfo = displayService.GetNextWakeupTime(d);
                        var minutes = Math.Round(nextWakeupInfo.SleepInSeconds / 60.0);
                        @($"{TimeZoneInfo.ConvertTimeFromUtc(nextWakeupInfo.NextWakeup, tz).ToString("g", dateCulture)}")
                        <br />
                        @Localizer["(in {0} minutes)", minutes]
                    }
                </td>
                <td>
                    @if (!d.IsDefault())
                    {
                        var missedConnects = displayService.GetMissedConnects(d);
                        if (missedConnects > 0)
                        {
                            var minFailuresStr = displayService.GetConfig(d, "alive_check_minimal_failure_count");
                            var minFailures = int.TryParse(minFailuresStr, out var mf) ? mf : 1;
                            var lastVisit = displayService.GetLastVisit(d);
                            var lastVisitLocalStr = lastVisit.HasValue
                            ? TimeZoneInfo.ConvertTimeFromUtc(lastVisit.Value, tz).ToString("g", dateCulture)
                            : Localizer["unknown"].Value;

                            if (missedConnects >= minFailures)
                            {
                                <span class="badge bg-danger">@Localizer["Frozen since {0}", lastVisitLocalStr]</span>
                            }
                            else
                            {
                                <span class="badge bg-info">@Localizer["Possibly frozen since {0}", lastVisitLocalStr]</span>
                            }
                            <br />
                            if (lastVisit.HasValue)
                            {
                                var hoursSince = (int)((DateTime.UtcNow - lastVisit.Value).TotalHours + 0.5);
                                <text>@Localizer["{0} hours, {1} missed connect(s)", hoursSince, missedConnects]</text>
                            }
                        }
                        else
                        {
                            <span class="badge bg-success">OK</span>
                        }

                        if (d.ApiKey == null)
                        {
                            <span class="badge bg-warning text-dark">@Localizer["Keyless"]</span>
                        }
                        if (displayService.GetConfigBool(d, "ota_mode"))
                        {
                            <span class="badge bg-warning text-dark">@Localizer["OTA mode active"]</span>
                        }
                    }
                </td>
                <td>
                    @if (!d.IsDefault())
                    {
                        if (d.Owner != null)
                        {
                            <small class="text-muted">@d.Owner.Username</small>
                        }
                        if (d.HideFromOtherUsers)
                        {
                            <span class="badge bg-secondary"><i class="bi bi-person-lock"></i> @Localizer["Hidden to others"]</span>
                        }
                    }
                </td>
                <td>
                    @if (!d.IsDefault())
                    {
                        <a href="@Url.Action(nameof(UiController.Home), "Ui", new { displayNumber = d.Id })">
                            <img src="@Url.Action(nameof(UiController.Bitmap), "Ui", new { displayNumber = d.Id })"
                                 style="max-height: 6rem; width: auto; border: 1px solid gray"
                                 alt="Display preview" />
                        </a>
                    }
                </td>
                <td>
                    @if (!d.IsDefault())
                    {
                        var bitmapAge = d.RenderedAt.HasValue ? DateTime.UtcNow - d.RenderedAt.Value : (TimeSpan?)null;
                        if (bitmapAge.HasValue)
                        {
                            var minutes = (int)(bitmapAge.Value.TotalMinutes + 0.5);
                            @($"{minutes} min")
                        }
                        else
                        {
                            <span class="badge bg-danger">N/A</span>
                        }
                    }
                </td>
                <td>
                    @if (!d.IsDefault())
                    {
                        <button type="button" class="btn btn-secondary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#delete_modal"
                                data-display-id="@d.Id"
                                data-display-name="@d.Name">
                            @Localizer["Delete"]
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Delete Modal -->
<div class="modal fade" id="delete_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["Delete display"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @Localizer["Do you really want to <b>completely delete</b> display #{0} <b>\"{1}\"</b>?", "<span class='delete_modal_display_id'></span>", "<span class='delete_modal_display_name'></span>"]
            </div>
            <div class="modal-footer">
                <form id="delete_form" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var jsL = {
            pairingActive: '@Html.Raw(Localizer["Pairing active, {0}s remaining (click to disable)"].Value)',
            enablePairing: '@Html.Raw(Localizer["Enable Pairing Mode (5 min)"].Value)'
        };

        // Pairing mode UI
        var pairingTimer = null;
        var pairingActive = false;

        function togglePairing() {
            if (pairingActive) {
                fetch('/api/pairing/deactivate', { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } })
                    .then(() => stopPairingCountdown());
            } else {
                fetch('/api/pairing/activate', { method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() } })
                    .then(r => r.json())
                    .then(data => startPairingCountdown(data.secondsRemaining));
            }
        }

        function getAntiForgeryToken() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function pairingLabel(s) { return jsL.pairingActive.replace('{0}', s); }

        function stopPairingCountdown() {
            clearInterval(pairingTimer);
            pairingActive = false;
            document.getElementById('pairing-btn').textContent = jsL.enablePairing;
        }

        function startPairingCountdown(seconds) {
            pairingActive = true;
            var remaining = seconds;
            document.getElementById('pairing-btn').textContent = pairingLabel(remaining);

            clearInterval(pairingTimer);
            pairingTimer = setInterval(function () {
                remaining--;
                if (remaining <= 0) {
                    stopPairingCountdown();
                } else {
                    document.getElementById('pairing-btn').textContent = pairingLabel(remaining);
                }

                // Poll status every 5s to catch early close (device paired)
                if (remaining % 5 === 0) {
                    fetch('/api/pairing/status')
                        .then(r => r.json())
                        .then(data => {
                            if (!data.active) {
                                stopPairingCountdown();
                                // Reload to show the newly paired display
                                window.location.reload();
                            }
                        });
                }
            }, 1000);
        }

        // Restore countdown if pairing is already active (e.g. page refresh)
        fetch('/api/pairing/status')
            .then(r => r.json())
            .then(data => { if (data.active && data.secondsRemaining > 0) startPairingCountdown(data.secondsRemaining); });

        $('#delete_modal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var modal = $(this);
            var displayId = button.data('display-id');
            modal.find('.delete_modal_display_id').text(displayId);
            modal.find('.delete_modal_display_name').text(button.data('display-name'));
            modal.find('#delete_form').attr('action', '@Url.Action(nameof(UiController.DeleteDisplay), "Ui", new { displayNumber = 0 })'.replace('/0', '/' + displayId));
        });
    </script>
}
