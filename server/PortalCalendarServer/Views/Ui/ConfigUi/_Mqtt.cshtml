@model PortalCalendarServer.Models.DatabaseEntities.Display
@using PortalCalendarServer.Models.POCOs
@inject IViewLocalizer Localizer

@{
    ViewData["IntegrationName"] = "mqtt";
}

<fieldset class="row mb-3" id="@(ViewData["IntegrationName"])_fieldset">
    @await Html.PartialAsync("ConfigUi/_IntegrationToggle", Model, ViewData)

    <div class="form-group row mt-3">
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = "mqtt_server", Label = Localizer["Server"].Value, ColClass = "col-md-3"
        })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = "mqtt_username", Label = Localizer["Username"].Value, ColClass = "col-md-3"
        })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = "mqtt_password", Label = Localizer["Password"].Value, ColClass = "col-md-3"
        })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = "mqtt_topic", Label = Localizer["Device topic"].Value, ColClass = "col-md-3"
        })
    </div>
</fieldset>
