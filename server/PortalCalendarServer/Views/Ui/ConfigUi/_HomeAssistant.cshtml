@model PortalCalendarServer.Models.DatabaseEntities.Display
@using PortalCalendarServer.Models.POCOs
@inject IViewLocalizer Localizer

@{
    ViewData["IntegrationName"] = "homeassistant";
}

<fieldset class="row mb-3" id="@(ViewData["IntegrationName"])_fieldset">
    @await Html.PartialAsync("ConfigUi/_IntegrationToggle", Model, ViewData)

    <div class="form-group row mt-3">
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = "homeassistant_url", Label = Localizer["Home Assistant URL"].Value,
            ColClass = "col-md-6",
            HelpText = Localizer["Base URL of your Home Assistant instance (e.g. http://homeassistant.local:8123)"].Value
        })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = "homeassistant_token", Label = Localizer["Long-Lived Access Token"].Value,
            ColClass = "col-md-6",
            HelpText = Localizer["Generate in Home Assistant: Profile → Security → Long-Lived Access Tokens"].Value
        })
    </div>
</fieldset>
