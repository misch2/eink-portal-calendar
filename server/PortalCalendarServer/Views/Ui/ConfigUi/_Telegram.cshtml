@model PortalCalendarServer.Models.DatabaseEntities.Display
@using PortalCalendarServer.Models.POCOs
@inject IViewLocalizer Localizer

@{
    ViewData["IntegrationName"] = "telegram";
}

<fieldset class="row mb-3" id="@(ViewData["IntegrationName"])_fieldset">
    @await Html.PartialAsync("ConfigUi/_IntegrationToggle", Model, ViewData)

    @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
    {
        Display = Model, Key = "telegram_api_key", Label = Localizer["API key"].Value,
        ColClass = "col-md-12", MarginClass = "mt-3"
    })
    @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
    {
        Display = Model, Key = "telegram_chat_id", Label = Localizer["Chat ID"].Value,
        ColClass = "col-md-12", MarginClass = "mt-3",
        HelpText = Localizer["See https://stackoverflow.com/questions/32423837/telegram-bot-how-to-get-a-group-chat-id to get the id."].Value
    })
</fieldset>
