@model Display
@using PortalCalendarServer.Models.DatabaseEntities
@using PortalCalendarServer.Models.POCOs
@using PortalCalendarServer.Services
@inject IDisplayService DisplayService
@inject ICurrentUserProvider CurrentUser
@inject IViewLocalizer Localizer

@if (!Model.IsDefault())
{
    <fieldset class="row mb-3">
        <legend class="w-auto">@Localizer["Name (title)"]</legend>
        <div class="col-md-12">
            <input id="display_name" name="display_name" type="text" class="form-control" value="@Model.Name">
        </div>
    </fieldset>

    <fieldset class="row mb-3">
        <legend class="w-auto">@Localizer["Parent display"]</legend>
        <div class="col-md-6">
            @{
                var allDisplays = DisplayService.GetVisibleDisplays().Where(d => d.Id != Model.Id).ToList();
            }
            <select id="parent_id" name="parent_id" class="form-select">
                <option value="">@Localizer["(none - no inheritance)"]</option>
                @foreach (var pd in allDisplays)
                {
                    <option value="@pd.Id" selected="@(Model.ParentId == pd.Id)">@pd.Name (ID @pd.Id)</option>
                }
            </select>
            <small class="form-text text-muted">@Localizer["Configuration values not set on this display will be inherited from the parent."]</small>
        </div>
    </fieldset>
}

@if (!Model.IsGroupOrDefault())
{
    <div class="form-group row mb-4">
        @await Html.PartialAsync("_ConfigSelect", new ConfigSelectModel
        {
            Display = Model, Key = "font_size", Label = Localizer["Font size"].Value,
            ColClass = "col-md-3",
            Options = new List<SelectOption>
            {
                new SelectOption { Value = "", Text = Localizer["Auto (theme default)"].Value },
                new SelectOption { Value = "8", Text = "8 pt" },
                new SelectOption { Value = "9", Text = "9 pt" },
                new SelectOption { Value = "10", Text = "10 pt" },
                new SelectOption { Value = "11", Text = "11 pt" },
                new SelectOption { Value = "12", Text = "12 pt" },
                new SelectOption { Value = "14", Text = "14 pt" },
                new SelectOption { Value = "16", Text = "16 pt" },
                new SelectOption { Value = "18", Text = "18 pt" },
                new SelectOption { Value = "20", Text = "20 pt" },
                new SelectOption { Value = "22", Text = "22 pt" },
                new SelectOption { Value = "24", Text = "24 pt" },
                new SelectOption { Value = "26", Text = "26 pt" },
                new SelectOption { Value = "28", Text = "28 pt" },
                new SelectOption { Value = "30", Text = "30 pt" },
                new SelectOption { Value = "32", Text = "32 pt" },
                new SelectOption { Value = "34", Text = "34 pt" },
                new SelectOption { Value = "36", Text = "36 pt" },
                }
            })
    </div>

    <fieldset class="mb-4">
        <legend class="col-md-12">@Localizer["Theme"]</legend>

        <div class="row mt-3">
            @{
                var themes = (List<Theme>)ViewData["Themes"]!;
            }
            <div class="col-md-6">
                <select id="theme_id" name="theme_id" class="form-select">
                    <option value=""></option>
                    @foreach (var theme in themes)
                    {
                        <option value="@theme.Id"
                                data-has-config="@theme.HasCustomConfig.ToString().ToLower()"
                                selected="@(Model.ThemeId == theme.Id)">
                            @Localizer[theme.DisplayName]
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-12">
                <div class="card Xborder-primary Xborder-1 Xbg-light">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-3 text-muted">
                            <i class="bi bi-gear"></i> @Localizer["Theme-specific Settings"]
                        </h6>
                        <div id="theme-customization" class="row">
                            <div class="col-12">
                                <small>@Localizer["Select a theme above to see available customization options"]</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>
}

<fieldset class="row mb-3">
    <legend class="w-auto">@Localizer["Location and locale"]</legend>
    <div class="form-group row">
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
        {
            Display = Model, Key = "lat", Label = Localizer["Latitude (+N/-S)"].Value, ColClass = "col-md-4"
                })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
                {
            Display = Model, Key = "lon", Label = Localizer["Longitude (+E/-W)"].Value, ColClass = "col-md-4"
                })
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
                {
            Display = Model, Key = "alt", Label = Localizer["Altitude (m)"].Value, ColClass = "col-md-4"
                })
    </div>
    <div class="form-group row mt-2">
        @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
                {
            Display = Model, Key = "timezone", Label = Localizer["Time Zone (format: \"UTC\", \"Europe/Prague\" etc.)"].Value,
                ColClass = "col-md-4"
                })
        @await Html.PartialAsync("_ConfigSelect", new ConfigSelectModel
                {
            Display = Model, Key = "date_culture", Label = Localizer["Date style"].Value,
                ColClass = "col-md-4",
                AllowEmpty = true,
                Options = new List<SelectOption>
                {
                    new SelectOption { Value = "cs-CZ", Text = "Česky" },
                    new SelectOption { Value = "en-US", Text = "English (US)" },
                    new SelectOption { Value = "en-GB", Text = "English (GB)" },
                }
                })
    </div>
</fieldset>

@if (!Model.IsDefault())
{
    <fieldset class="row mb-3">
        <legend class="w-auto">@Localizer["Visibility"]</legend>
        <div class="col-md-12">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="hide_from_other_users" name="hide_from_other_users"
                       @(Model.HideFromOtherUsers ? "checked" : "")>
                <label class="form-check-label" for="hide_from_other_users">@Localizer["Hide from other users"]</label>
            </div>
        </div>
        @if (CurrentUser.IsAdmin)
        {
            var allUsers = (List<AppUser>?)ViewData["AllUsers"];
            if (allUsers != null)
            {
                <div class="col-md-4 mt-3">
                    <label class="form-label">@Localizer["Owner"]</label>
                    <select name="owner_id" class="form-select">
                        <option value="">@Localizer["(none)"]</option>
                        @foreach (var user in allUsers)
                        {
                            <option value="@user.Id" selected="@(Model.OwnerId == user.Id)">@user.Username</option>
                        }
                    </select>
                </div>
            }
        }
    </fieldset>
}
