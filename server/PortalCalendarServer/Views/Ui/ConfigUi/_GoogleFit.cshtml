@model PortalCalendarServer.Models.DatabaseEntities.Display
@using PortalCalendarServer.Controllers
@using PortalCalendarServer.Models.POCOs
@inject IViewLocalizer Localizer

@{
    ViewData["IntegrationName"] = "googlefit";
}

<fieldset class="row mb-3" id="@(ViewData["IntegrationName"])_fieldset">
    @await Html.PartialAsync("ConfigUi/_IntegrationToggle", Model, ViewData)

    <div class="col-md-12 mt-3 mb-3">
        <a class="btn btn-primary" href="@Url.Action(nameof(GoogleFitAuthController.GoogleFitRedirect), "GoogleFitAuth", new { displayNumber = Model.Id })">@Localizer["Authorize calendar to use Google Fit with the values below"]</a>
    </div>

    @{
        var googleApisUrl = "https://console.cloud.google.com/apis/";
    }
    <div class="col-md-12">
        @Localizer["See <a href='{0}'>{0}</a> to get client ID and secret values:", googleApisUrl]
    </div>
    @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
    {
        Display = Model, Key = "googlefit_client_id", Label = Localizer["Client ID"].Value,
        ColClass = "col-md-12", MarginClass = "mt-2"
    })
    @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
    {
        Display = Model, Key = "googlefit_client_secret", Label = Localizer["Client secret"].Value,
        ColClass = "col-md-12", MarginClass = "mt-2"
    })
    @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
    {
        Display = Model, Key = "_googlefit_refresh_token", Label = Localizer["Refresh token (generated automatically)"].Value,
        ColClass = "col-md-12", MarginClass = "mt-2", Disabled = true
    })
    @await Html.PartialAsync("_ConfigTextInput", new ConfigInputModel
    {
        Display = Model, Key = "_googlefit_access_token", Label = Localizer["Auth token (generated automatically)"].Value,
        ColClass = "col-md-12", MarginClass = "mt-2", Disabled = true
    })
</fieldset>
