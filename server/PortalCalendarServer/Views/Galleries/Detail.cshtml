@model PortalCalendarServer.Models.DatabaseEntities.Gallery

<p>
    <a href="/galleries">&larr; Back to galleries</a>
</p>

<h4>Upload Image</h4>
<form method="post" action="/galleries/@Model.Id/upload" enctype="multipart/form-data" class="row g-3 mb-4" style="max-width: 600px;">
    @Html.AntiForgeryToken()
    <div class="col-12">
        <label class="form-label">Image file</label>
        <input type="file" name="file" class="form-control" accept="image/*" required />
    </div>
    <div class="col-12">
        <label class="form-label">Description (optional)</label>
        <input type="text" name="description" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Upload</button>
    </div>
</form>

@if (Model.Images.Count == 0)
{
    <p class="text-muted">No images in this gallery yet.</p>
}
else
{
    <div class="row">
        @foreach (var image in Model.Images.OrderBy(i => i.UploadedAt))
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card">
                    <img src="/galleries/@Model.Id/images/@image.Id?v=@(image.UploadedAt.Ticks)"
                         class="card-img-top"
                         alt="@(image.Description ?? "Gallery image")"
                         style="max-height: 200px; object-fit: contain; background: #f8f9fa;" />
                    <div class="card-body">
                        <p class="card-text">
                            <a href="#" class="text-decoration-none edit-description-link"
                               data-bs-toggle="modal"
                               data-bs-target="#edit_description_modal"
                               data-image-id="@image.Id"
                               data-image-description="@(image.Description ?? "")">
                                @if (!string.IsNullOrEmpty(image.Description))
                                {
                                    @image.Description
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No description — click to add</span>
                                }
                                <small>✏️</small>
                            </a>
                        </p>
                        <p class="card-text"><small class="text-muted">@image.UploadedAt.ToString("yyyy-MM-dd HH:mm")</small></p>
                        <form method="post" action="/galleries/@Model.Id/images/delete/@image.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Edit Image Modal -->
<div class="modal fade" id="edit_description_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="edit_description_form" method="post" action="" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="edit_description_input" class="form-label">Description</label>
                        <input type="text" id="edit_description_input" name="description" class="form-control" />
                    </div>
                    <div>
                        <label for="edit_file_input" class="form-label">Replace image (optional)</label>
                        <input type="file" id="edit_file_input" name="file" class="form-control" accept="image/*" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#edit_description_modal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        var modal = $(this);
        var imageId = button.data('image-id');
        var description = button.data('image-description');
        modal.find('#edit_description_input').val(description);
        modal.find('#edit_file_input').val('');
        modal.find('#edit_description_form').attr('action', '/galleries/@Model.Id/images/' + imageId + '/description');
    });
    $('#edit_description_modal').on('shown.bs.modal', function () {
        $('#edit_description_input').trigger('focus');
    });
</script>
}
