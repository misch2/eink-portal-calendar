@model PortalCalendarServer.Models.DatabaseEntities.Gallery

@functions {
    static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }
}

@{
    var allGalleries = (List<PortalCalendarServer.Models.DatabaseEntities.Gallery>)ViewData["AllGalleries"]!;
    var otherGalleries = allGalleries.Where(g => g.Id != Model.Id).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#upload_image_modal">
        <i class="bi bi-upload me-1"></i> Upload Image
    </button>
    <h4 class="mb-0">Images</h4>
    <div></div>
</div>

@{
    var hiddenImageIds = Model.ImageLinks
        .Where(l => l.IsHidden)
        .Select(l => l.GalleryImageId)
        .ToHashSet();
    var rotationByImageId = Model.ImageLinks
        .ToDictionary(l => l.GalleryImageId, l => l.Rotation);
}

@if (Model.Images.Count == 0)
{
    <p class="text-muted">No images in this gallery yet.</p>
}
else
{
    <div class="row">
        @foreach (var image in Model.Images.OrderByDescending(i => i.UploadedAt))
        {
            var isHidden = hiddenImageIds.Contains(image.Id);
            var imageRotation = rotationByImageId.GetValueOrDefault(image.Id, 0);
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100 @(isHidden ? "gallery-card--hidden" : "")" data-image-id="@image.Id">
                    <div class="position-relative">
                        <a href="#" class="gallery-preview-link"
                           data-bs-toggle="modal"
                           data-bs-target="#preview_image_modal"
                           data-image-src="/galleries/@Model.Id/images/@image.Id?v=@(image.UploadedAt.Ticks)"
                           data-image-alt="@(image.Description ?? "Gallery image")"
                           data-image-rotation="@imageRotation">
                            <div class="gallery-thumb-wrapper">
                                <img src="/galleries/@Model.Id/images/@image.Id?v=@(image.UploadedAt.Ticks)"
                                     class="card-img-top gallery-thumb"
                                     alt="@(image.Description ?? "Gallery image")"
                                     data-rotation="@imageRotation" />
                            </div>
                        </a>
                        <div class="position-absolute top-0 end-0 p-1 d-flex flex-column gap-1 gallery-actions">
                            <form method="post"
                                  action="/galleries/@Model.Id/images/@image.Id/toggle-visibility"
                                  class="gallery-ajax-form"
                                  style="margin:0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="isHidden" value="@(isHidden ? "false" : "true")" />
                                <button type="submit"
                                        class="gallery-action-btn"
                                        title="@(isHidden ? "Show" : "Hide")">
                                    <i class="bi @(isHidden ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                            <form method="post"
                                  action="/galleries/@Model.Id/images/@image.Id/rotate"
                                  class="gallery-ajax-form"
                                  style="margin:0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rotation" value="@imageRotation" />
                                <button type="submit"
                                        class="gallery-action-btn"
                                        title="Rotate 90°">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </form>
                            @if (otherGalleries.Count > 0)
                            {
                                <div class="dropdown">
                                    <button type="button" class="gallery-action-btn"
                                       data-bs-toggle="dropdown"
                                       title="Copy to gallery">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        @foreach (var g in otherGalleries)
                                        {
                                            <li>
                                                <form method="post"
                                                      action="/galleries/@Model.Id/images/@image.Id/copy-to/@g.Id"
                                                      class="gallery-ajax-form"
                                                      style="margin:0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item">@g.Name</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            <button type="button" class="gallery-action-btn edit-description-link"
                               data-bs-toggle="modal"
                               data-bs-target="#edit_description_modal"
                               data-image-id="@image.Id"
                               data-image-description="@(image.Description ?? "")"
                               title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="gallery-action-btn gallery-action-btn--danger delete-image-link"
                               data-bs-toggle="modal"
                               data-bs-target="#delete_image_modal"
                               data-image-id="@image.Id"
                               title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body py-2 px-3">
                        <p class="card-text mb-1">
                            @if (!string.IsNullOrEmpty(image.Description))
                            {
                                @image.Description
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No description</span>
                            }
                        </p>
                        <p class="card-text mb-0 d-flex justify-content-between">
                            <small class="text-muted">@image.UploadedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            <small class="text-muted text-end gallery-image-meta">
                                @if (image.Width.HasValue && image.Height.HasValue && image.FileSize.HasValue)
                                {
                                    <span>@(image.Width)×@(image.Height), @FormatFileSize(image.FileSize.Value)</span>
                                }
                            </small>
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Preview Image Modal (lightbox) -->
<div class="modal fade" id="preview_image_modal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-header border-0 p-0 position-absolute top-0 end-0" style="z-index: 1;">
                <button type="button" class="btn-close btn-close-white m-2" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 text-center">
                <img id="preview_image" src="" alt="" class="img-fluid" style="max-height: 90vh; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

<!-- Upload Image Modal -->
<div class="modal fade" id="upload_image_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/galleries/@Model.Id/upload" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Image file</label>
                        <input type="file" name="file" class="form-control" accept="image/*" required />
                    </div>
                    <div>
                        <label class="form-label">Description (optional)</label>
                        <input type="text" name="description" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i> Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Image Modal -->
<div class="modal fade" id="delete_image_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Do you really want to delete this image?
            </div>
            <div class="modal-footer">
                <form id="delete_image_form" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Image Modal -->
<div class="modal fade" id="edit_description_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="edit_description_form" method="post" action="" enctype="multipart/form-data" class="gallery-ajax-form">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="edit_description_input" class="form-label">Description</label>
                        <input type="text" id="edit_description_input" name="description" class="form-control" />
                    </div>
                    <div>
                        <label for="edit_file_input" class="form-label">Replace image (optional)</label>
                        <input type="file" id="edit_file_input" name="file" class="form-control" accept="image/*" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
<style>
    .gallery-thumb-wrapper {
        width: 100%;
        height: 180px;
        overflow: hidden;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .gallery-thumb {
        display: block;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        cursor: zoom-in;
    }
    .gallery-thumb[data-rotation="90"],
    .gallery-thumb[data-rotation="270"] {
        max-width: 180px;
        max-height: none;
    }
    .gallery-thumb[data-rotation="90"]  { transform: rotate(90deg); }
    .gallery-thumb[data-rotation="180"] { transform: rotate(180deg); }
    .gallery-thumb[data-rotation="270"] { transform: rotate(270deg); }
    .gallery-card--hidden {
        opacity: 0.5;
        filter: grayscale(100%);
    }
    .gallery-card--hidden:hover {
        opacity: 0.7;
        filter: none;
    }
    .gallery-actions {
        opacity: 0;
        transition: opacity 0.2s;
    }
    .card:hover .gallery-actions,
    .gallery-actions:has(.dropdown-menu.show) {
        opacity: 1;
    }
    .gallery-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        font-size: 0.75rem;
        border-radius: 4px;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        text-decoration: none;
        transition: background 0.15s;
        border: none;
        padding: 0;
        font: inherit;
        cursor: pointer;
    }
    .gallery-action-btn:hover {
        background: rgba(0, 0, 0, 0.8);
        color: #fff;
    }
    .gallery-action-btn--danger:hover {
        background: rgba(220, 53, 69, 0.85);
        color: #fff;
    }
</style>
}

@section Scripts {
<script>
    // Lightbox
    $('#preview_image_modal').on('show.bs.modal', function (event) {
        var link = $(event.relatedTarget);
        var rotation = link.data('image-rotation') || 0;
        var isSideways = (rotation === 90 || rotation === 270);
        $(this).find('#preview_image')
            .attr('src', link.data('image-src'))
            .attr('alt', link.data('image-alt'))
            .css({
                'transform': rotation ? 'rotate(' + rotation + 'deg)' : '',
                'max-height': isSideways ? 'calc(100vw - 4rem)' : '90vh',
                'max-width': isSideways ? '90vh' : '100%'
            });
    });

    // Edit description modal — stash the image ID for the AJAX handler
    var editImageId = null;
    $('#edit_description_modal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget);
        editImageId = button.data('image-id');
        $(this).find('#edit_description_input').val(button.data('image-description'));
        $(this).find('#edit_file_input').val('');
        $(this).find('#edit_description_form').attr('action', '/galleries/@Model.Id/images/' + editImageId + '/description');
    });
    $('#edit_description_modal').on('shown.bs.modal', function () {
        $('#edit_description_input').trigger('focus');
    });

    // Delete modal
    $('#delete_image_modal').on('show.bs.modal', function (event) {
        var imageId = $(event.relatedTarget).data('image-id');
        $(this).find('#delete_image_form').attr('action', '/galleries/@Model.Id/images/delete/' + imageId);
    });

    // Generic AJAX handler — server returns JSON, we apply returned fields to the card
    function showPageAlert(message, type) {
        var div = $('<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert"></div>')
            .text(message)
            .append('<button type="button" class="btn-close" data-bs-dismiss="alert"></button>');
        $('.d-flex.justify-content-between').before(div);
        setTimeout(function () {
            if (window.bootstrap && window.bootstrap.Alert) {
                new bootstrap.Alert(div[0]).close();
            } else {
                div.remove();
            }
        }, 5000);
    }

    $(document).on('submit', '.gallery-ajax-form', function (e) {
        e.preventDefault();
        var form = $(this);
        fetch(form.attr('action'), { method: 'POST', body: new FormData(form[0]) })
            .then(function (r) {
                var ct = r.headers.get('Content-Type') || '';
                if (!r.ok || !ct.includes('application/json')) {
                    if (ct.includes('application/json')) {
                        return r.json().then(function (errData) {
                            throw new Error(errData.error || 'Request failed with status ' + r.status);
                        });
                    }
                    throw new Error('Request failed with status ' + r.status);
                }
                return r.json();
            })
            .then(function (data) {
                // Find the card: either the form is inside the card, or it's a modal form
                var card = form.closest('.card');
                if (!card.length && editImageId) {
                    card = $('.card[data-image-id="' + editImageId + '"]');
                }

                if (data.isHidden !== undefined) {
                    card.toggleClass('gallery-card--hidden', data.isHidden);
                    var vf = card.find('form[action*="toggle-visibility"]');
                    vf.find('button').attr('title', data.isHidden ? 'Show' : 'Hide');
                    vf.find('i').attr('class', 'bi ' + (data.isHidden ? 'bi-eye-slash' : 'bi-eye'));
                    vf.find('input[name="isHidden"]').val(data.isHidden ? 'false' : 'true');
                }
                if (data.rotation !== undefined) {
                    card.find('.gallery-thumb').attr('data-rotation', data.rotation);
                    card.find('.gallery-preview-link').data('image-rotation', data.rotation);
                    card.find('input[name="rotation"]').val(data.rotation);
                }
                if (data.description !== undefined) {
                    var el = card.find('.card-text').first();
                    if (data.description) {
                        el.text(data.description);
                    } else {
                        el.html('<span class="text-muted fst-italic">No description</span>');
                    }
                    // Update the edit button's stored description
                    card.find('.edit-description-link').data('image-description', data.description || '');

                    // If the image file was replaced, update the thumbnail and preview URLs
                    if (data.imageVersion) {
                        var imageId = card.data('image-id');
                        var newSrc = '/galleries/@Model.Id/images/' + imageId + '?v=' + data.imageVersion;
                        card.find('.gallery-thumb').attr('src', newSrc);
                        card.find('.gallery-preview-link').data('image-src', newSrc);

                        if (data.imageMeta) {
                            card.find('.gallery-image-meta').html('<span>' + data.imageMeta + '</span>');
                        }
                    }

                    // Close the modal if the form was in one (Bootstrap 5 JS API)
                    var modalEl = form.closest('.modal')[0];
                    if (modalEl && window.bootstrap && window.bootstrap.Modal) {
                        var modalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        modalInstance.hide();
                    }
                }
                if (data.message !== undefined) {
                    // Show success message for copy-to-gallery and similar actions
                    showPageAlert(data.message, 'success');
                }
            })
            .catch(function (err) {
                showPageAlert('Error: ' + err.message, 'danger');
            });
    });
</script>
}
