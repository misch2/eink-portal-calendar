@model List<PortalCalendarServer.Models.DatabaseEntities.Gallery>
@using PortalCalendarServer.Controllers

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Images</th>
            <th scope="col">Created</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var gallery in Model)
        {
            <tr>
                <td>@gallery.Id</td>
                <td>
                    <a href="/galleries/@gallery.Id">@gallery.Name</a>
                </td>
                <td>@gallery.Images.Count</td>
                <td>@gallery.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#delete_gallery_modal"
                            data-gallery-id="@gallery.Id"
                            data-gallery-name="@gallery.Name"
                            title="Delete gallery">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#create_gallery_modal">
    <i class="bi bi-plus-lg me-1"></i> New Gallery
</button>

<!-- Create Gallery Modal -->
<div class="modal fade" id="create_gallery_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Gallery</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/galleries/create">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div>
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Gallery Modal -->
<div class="modal fade" id="delete_gallery_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete gallery</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Do you really want to delete gallery <b>"<span class="delete_modal_gallery_name"></span>"</b> and all its images?
            </div>
            <div class="modal-footer">
                <form id="delete_gallery_form" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var deleteGalleryModal = document.getElementById('delete_gallery_modal');
    deleteGalleryModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var galleryId = button.getAttribute('data-gallery-id');
        var galleryName = button.getAttribute('data-gallery-name');
        deleteGalleryModal.querySelector('.delete_modal_gallery_name').textContent = galleryName;
        deleteGalleryModal.querySelector('#delete_gallery_form').action = '/galleries/delete/' + galleryId;
    });

    var createGalleryModal = document.getElementById('create_gallery_modal');
    createGalleryModal.addEventListener('shown.bs.modal', function () {
        createGalleryModal.querySelector('input[name="name"]').focus();
    });
</script>
}
