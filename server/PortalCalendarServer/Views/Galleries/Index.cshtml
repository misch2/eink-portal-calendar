@model List<PortalCalendarServer.Models.DatabaseEntities.Gallery>
@using PortalCalendarServer.Controllers
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["Galleries"].Value;
}

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">@Localizer["Id"]</th>
            <th scope="col">@Localizer["Name"]</th>
            <th scope="col">@Localizer["Images"]</th>
            <th scope="col">@Localizer["Created"]</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var gallery in Model)
        {
            <tr>
                <td>@gallery.Id</td>
                <td>
                    <a href="/galleries/@gallery.Id">@gallery.Name</a>
                </td>
                <td>@gallery.Images.Count</td>
                <td>@gallery.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#rename_gallery_modal"
                            data-gallery-id="@gallery.Id"
                            data-gallery-name="@gallery.Name"
                            title="@Localizer["Rename gallery"]">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#copy_gallery_modal"
                            data-gallery-id="@gallery.Id"
                            data-gallery-name="@gallery.Name"
                            title="@Localizer["Copy gallery"]">
                        <i class="bi bi-copy"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#delete_gallery_modal"
                            data-gallery-id="@gallery.Id"
                            data-gallery-name="@gallery.Name"
                            title="@Localizer["Delete gallery"]">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#create_gallery_modal">
    <i class="bi bi-plus-lg me-1"></i> @Localizer["New Gallery"]
</button>

<!-- Create Gallery Modal -->
<div class="modal fade" id="create_gallery_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["Create New Gallery"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/galleries/create">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div>
                        <label class="form-label">@Localizer["Name"]</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> @Localizer["Create"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Gallery Modal -->
<div class="modal fade" id="delete_gallery_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["Delete gallery"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @Localizer["Do you really want to delete gallery <b>\"{0}\"</b> and all its images?", "<span class='delete_modal_gallery_name'></span>"]
            </div>
            <div class="modal-footer">
                <form id="delete_gallery_form" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Copy Gallery Modal -->
<div class="modal fade" id="copy_gallery_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["Copy gallery"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="copy_gallery_form" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>@Localizer["Copy gallery <b>\"{0}\"</b> and all its images.", "<span class='copy_modal_gallery_name'></span>"]</p>
                    <div>
                        <label class="form-label">@Localizer["New gallery name"]</label>
                        <input type="text" name="name" id="copy_gallery_name_input" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-copy me-1"></i> @Localizer["Copy"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Rename Gallery Modal -->
<div class="modal fade" id="rename_gallery_modal" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["Rename gallery"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="rename_gallery_form" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div>
                        <label class="form-label">@Localizer["New name"]</label>
                        <input type="text" name="name" id="rename_gallery_name_input" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Rename"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var deleteGalleryModal = document.getElementById('delete_gallery_modal');
    deleteGalleryModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var galleryId = button.getAttribute('data-gallery-id');
        var galleryName = button.getAttribute('data-gallery-name');
        deleteGalleryModal.querySelector('.delete_modal_gallery_name').textContent = galleryName;
        deleteGalleryModal.querySelector('#delete_gallery_form').action = '/galleries/delete/' + galleryId;
    });

    var copyGalleryModal = document.getElementById('copy_gallery_modal');
    copyGalleryModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var galleryId = button.getAttribute('data-gallery-id');
        var galleryName = button.getAttribute('data-gallery-name');
        copyGalleryModal.querySelector('.copy_modal_gallery_name').textContent = galleryName;
        copyGalleryModal.querySelector('#copy_gallery_form').action = '/galleries/copy/' + galleryId;
        copyGalleryModal.querySelector('#copy_gallery_name_input').value = galleryName + ' (copy)';
    });
    copyGalleryModal.addEventListener('shown.bs.modal', function () {
        var input = copyGalleryModal.querySelector('#copy_gallery_name_input');
        input.focus();
        input.select();
    });

    var renameGalleryModal = document.getElementById('rename_gallery_modal');
    renameGalleryModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var galleryId = button.getAttribute('data-gallery-id');
        var galleryName = button.getAttribute('data-gallery-name');
        renameGalleryModal.querySelector('#rename_gallery_form').action = '/galleries/rename/' + galleryId;
        renameGalleryModal.querySelector('#rename_gallery_name_input').value = galleryName;
    });
    renameGalleryModal.addEventListener('shown.bs.modal', function () {
        var input = renameGalleryModal.querySelector('#rename_gallery_name_input');
        input.focus();
        input.select();
    });

    var createGalleryModal = document.getElementById('create_gallery_modal');
    createGalleryModal.addEventListener('shown.bs.modal', function () {
        createGalleryModal.querySelector('input[name="name"]').focus();
    });
</script>
}
